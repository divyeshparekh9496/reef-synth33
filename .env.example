# Nebius Token Factory (required for the Nemotron agents; without it they use rule fallbacks)
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Override model IDs if Token Factory renames them (list: GET /v1/models)
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: LangSmith tracing of every agent call (pip install langsmith)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=reefsynth
